# Copy to .env (gitignored). Never commit real values.

# Linear (optional: only for /sync and Linear routing)
LINEAR_API_KEY=

# Fireflies / Granola ingestion (optional shared secrets for the webhook endpoints)
FIREFLIES_WEBHOOK_SECRET=
GRANOLA_WEBHOOK_SECRET=
MANUAL_WEBHOOK_SECRET=

# Granola API polling (optional)
GRANOLA_API_KEY=
# GRANOLA_API_BASE_URL=
# GRANOLA_CALENDAR_ICS_URL=

# Slack notifications (optional)
SLACK_WEBHOOK_URL=

# ROUTER_PORT=3333
# ROUTER_HOST=127.0.0.1   # set to 0.0.0.0 only inside a container/behind a trusted proxy
# ADAPTER_HOST=127.0.0.1

# Fireflies adapter signature check (required unless ROUTER_ALLOW_UNAUTHENTICATED=1)
FIREFLIES_WEBHOOK_SIGNING_SECRET=

# Local testing only: allow ingest with no secret (default is to refuse)
# ROUTER_ALLOW_UNAUTHENTICATED=1
