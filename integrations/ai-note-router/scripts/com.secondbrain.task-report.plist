<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.secondbrain.task-report</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/path/to/second-brain/integrations/ai-note-router/scripts/start-task-report.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/path/to/second-brain</string>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/SecondBrain-TaskReport.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/SecondBrain-TaskReport-err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
